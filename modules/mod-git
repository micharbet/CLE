## `gipul`            - just git pull
function gpul() {
	git pull
}

## `gipus`            - git push into origin / current working branch
function gpus() {
	BRANCH=`git symbolic-ref --short HEAD`
	_clebold git push -u origin $BRANCH 
	git push -u origin $BRANCH 
}

## `gicom [message]`  - git commit, if message not specified, opens editor
function gcom() {
	if [ $# -eq 0 ]; then
		git commit -a
	else
		git commit -a -m "$*"
	fi
}

## `gsta`            - git status
function gsta() {
	git status
}

## `glog`            - git log
function glog() {
	git log
}

## `gidif`            - git diff
function gdif() {
	git diff
}

## `giout`            - git checkout with branch selector
function gout()
(
	if [ $1 ]; then
		BR=$1
	else
		BRL=`git branch --list --no-color | sed 's/\*//'`
		PS3="$_CL branch # $_CN"
		select BR in $BRL; do
			[ $BR ] && break
		done
	fi
        git checkout $BR
)

## `gurl`            - show clickable URL of the current repository
function gurl()
{
	git config --get remote.origin.url | sed -e 's/:/\//' -e 's/git@/https:\/\//' -e 's/\.git//'
}

